<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SDM.Desktop.ViewModels"
        x:Class="SDM.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SDM — Speed Download Manager"
        Icon="/Assets/Branding/sdm-mark.png"
        Width="900"
        Height="660"
        MinWidth="740"
        MinHeight="560"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBackgroundBrush}">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="40,34,40,26">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
      <Image Source="/Assets/Branding/sdm-mark.png" Width="46" Height="46" VerticalAlignment="Center" />

      <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3" VerticalAlignment="Center">
        <TextBlock Classes="wordmark" Text="{Binding Name}" />
        <TextBlock Classes="tagline" Text="{Binding FullName}" />
      </StackPanel>

      <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
        <TextBlock Text="{Binding Version}"
                   FontSize="11.5"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource BrandSkyBrush}" />
      </Border>
    </Grid>

    <Border Grid.Row="1" Height="1" Margin="0,26,0,0" Background="{StaticResource HairlineBrush}" />

    <!-- New download -->
    <Border Grid.Row="2" Classes="card" Margin="0,28,0,0">
      <StackPanel Spacing="15">
        <TextBlock Classes="sectionLabel" Text="NEW DOWNLOAD" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Classes="address"
                   Text="{Binding Address}"
                   PlaceholderText="https://example.com/file.zip" />

          <Button Grid.Column="1"
                  Classes="primary"
                  Margin="12,0,0,0"
                  Content="Download"
                  Command="{Binding AddCommand}"
                  IsDefault="True" />
        </Grid>

        <TextBlock Classes="error"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!-- Transfers -->
    <Grid Grid.Row="3" Margin="0,22,0,0" RowDefinitions="Auto,*">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,12">
        <TextBlock Classes="sectionLabel" Text="TRANSFERS" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="ghost"
                Content="Clear finished"
                Command="{Binding ClearFinishedCommand}"
                IsVisible="{Binding HasDownloads}" />
      </Grid>

      <!-- Empty state -->
      <Border Grid.Row="1"
              Classes="card"
              IsVisible="{Binding !HasDownloads}"
              VerticalAlignment="Top">
        <StackPanel Spacing="7" Margin="0,14" HorizontalAlignment="Center">
          <TextBlock Text="Nothing downloading yet"
                     FontSize="14.5"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Classes="footnote"
                     Text="Paste an address above to start. Up to three run at once."
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1"
                    IsVisible="{Binding HasDownloads}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Downloads}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DownloadItemViewModel">
              <Border Classes="card" Margin="0,0,0,12" Padding="22,18">
                <StackPanel Spacing="13">

                  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                    <TextBlock Classes="fileName" Text="{Binding FileName}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding PercentageText}"
                               Margin="14,0,0,0"
                               FontSize="19"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ShowsProgress}"
                               Foreground="{StaticResource BrandGradientBrush}" />

                    <Button Grid.Column="2"
                            Classes="iconGhost"
                            Margin="10,0,0,0"
                            Content="❚❚"
                            ToolTip.Tip="Pause — keeps what has already been downloaded"
                            Command="{Binding PauseCommand}"
                            IsVisible="{Binding IsActive}" />

                    <Button Grid.Column="3"
                            Classes="iconGhost"
                            Margin="10,0,0,0"
                            Content="▶"
                            ToolTip.Tip="Resume from where it stopped"
                            Command="{Binding ResumeCommand}"
                            IsVisible="{Binding IsResumable}" />

                    <Button Grid.Column="4"
                            Classes="iconDanger"
                            Margin="8,0,0,0"
                            Content="✕"
                            ToolTip.Tip="Cancel and delete what has been downloaded"
                            Command="{Binding CancelCommand}" />
                  </Grid>

                  <ProgressBar Classes="brand"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding Percentage}"
                               IsIndeterminate="{Binding IsIndeterminate}"
                               IsVisible="{Binding ShowsProgress}" />

                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Classes="metric" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1"
                               Classes="metric"
                               Margin="16,0,0,0"
                               Text="{Binding SpeedText}"
                               Foreground="{StaticResource BrandSkyBrush}" />

                    <TextBlock Grid.Column="2"
                               Classes="metric"
                               Margin="16,0,0,0"
                               Text="{Binding RemainingText}" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCompleted}">
                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                            Background="{StaticResource SuccessBrush}" />
                    <TextBlock Text="Complete" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" />
                  </StackPanel>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
      <TextBlock Classes="footnote" Text="WINDOWS-FIRST · PORTABLE ARCHITECTURE" LetterSpacing="1.2" />
      <TextBlock Grid.Column="1" Classes="footnote" Text="Transfers are remembered between sessions" />
    </Grid>

  </Grid>
</Window>
