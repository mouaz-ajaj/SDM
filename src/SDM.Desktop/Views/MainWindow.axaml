<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SDM.Desktop.ViewModels"
        x:Class="SDM.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SDM — Speed Download Manager"
        Width="840"
        Height="520"
        MinWidth="680"
        MinHeight="440"
        Background="#10151C"
        FontFamily="Segoe UI">
  <Grid RowDefinitions="Auto,*,Auto" Margin="44,38,44,34">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Name}"
                   FontSize="38"
                   FontWeight="SemiBold"
                   LetterSpacing="2"
                   Foreground="#2F80FF" />
        <TextBlock Text="{Binding FullName}"
                   FontSize="16"
                   Foreground="#B7C3D4" />
      </StackPanel>

      <Border Grid.Column="1"
              VerticalAlignment="Top"
              Background="#152432"
              BorderBrush="#28465B"
              BorderThickness="1"
              CornerRadius="15"
              Padding="14,7">
        <TextBlock Text="FOUNDATION / STAGE 1"
                   FontSize="11"
                   FontWeight="SemiBold"
                   LetterSpacing="1"
                   Foreground="#20D9E8" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,40,0,38" ColumnDefinitions="8,*">
      <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Stretch">
        <Border Height="88" CornerRadius="4" Background="#2F80FF" />
        <Border Height="42" CornerRadius="4" Background="#20D9E8" Opacity="0.9" />
        <Border Height="20" CornerRadius="4" Background="#28465B" />
      </StackPanel>

      <Border Grid.Column="1"
              Margin="20,0,0,0"
              Padding="34,30"
              Background="#151C25"
              BorderBrush="#263241"
              BorderThickness="1"
              CornerRadius="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="9" Height="9" CornerRadius="5" Background="#20D9E8" />
            <TextBlock Text="{Binding FoundationStatus}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#E8EEF6" />
          </StackPanel>

          <TextBlock Grid.Row="1"
                     Margin="0,20,0,0"
                     Text="Architecture online. Downloading remains intentionally disabled."
                     FontSize="21"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Foreground="#F5F8FC" />

          <TextBlock Grid.Row="2"
                     Margin="0,14,0,0"
                     MaxWidth="560"
                     HorizontalAlignment="Left"
                     Text="{Binding NextStageMessage}"
                     FontSize="14"
                     LineHeight="22"
                     TextWrapping="Wrap"
                     Foreground="#91A0B4" />

          <Border Grid.Row="3"
                  Margin="0,28,0,0"
                  BorderBrush="#28465B"
                  BorderThickness="0,1,0,0"
                  Padding="0,18,0,0">
            <TextBlock Text="No network requests · No persistence · No browser integration"
                       FontSize="12"
                       Foreground="#6F8299" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBlock Text="WINDOWS-FIRST · PORTABLE ARCHITECTURE"
                 FontSize="10"
                 LetterSpacing="1.2"
                 Foreground="#587087" />
      <TextBlock Grid.Column="1"
                 Text="{Binding Version}"
                 FontSize="11"
                 Foreground="#6F8299" />
    </Grid>
  </Grid>
</Window>
