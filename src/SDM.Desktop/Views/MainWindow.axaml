<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SDM.Desktop.ViewModels"
        x:Class="SDM.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SDM — Speed Download Manager"
        Icon="/Assets/Branding/sdm-mark.png"
        Width="880"
        Height="600"
        MinWidth="720"
        MinHeight="540"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBackgroundBrush}">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="40,34,40,28">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
      <Image Source="/Assets/Branding/sdm-mark.png"
             Width="46"
             Height="46"
             VerticalAlignment="Center" />

      <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3" VerticalAlignment="Center">
        <TextBlock Classes="wordmark" Text="{Binding Name}" />
        <TextBlock Classes="tagline" Text="{Binding FullName}" />
      </StackPanel>

      <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
        <TextBlock Text="{Binding Version}"
                   FontSize="11.5"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource BrandSkyBrush}" />
      </Border>
    </Grid>

    <Border Grid.Row="1"
            Height="1"
            Margin="0,26,0,0"
            Background="{StaticResource HairlineBrush}" />

    <!-- Body -->
    <StackPanel Grid.Row="2" Margin="0,30,0,0" Spacing="18">

      <!-- New download -->
      <Border Classes="card">
        <StackPanel Spacing="15">
          <TextBlock Classes="sectionLabel" Text="NEW DOWNLOAD" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Classes="address"
                     Text="{Binding Address}"
                     PlaceholderText="https://example.com/file.zip" />

            <Button Grid.Column="1"
                    Classes="primary"
                    Margin="12,0,0,0"
                    Content="Download"
                    Command="{Binding DownloadCommand}"
                    IsDefault="True" />
          </Grid>

          <TextBlock Classes="error"
                     Text="{Binding ErrorMessage}"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <!-- Transfer -->
      <Border Classes="card" IsVisible="{Binding HasTransfer}">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Classes="sectionLabel" Text="TRANSFER" />
              <TextBlock Classes="fileName" Text="{Binding FileName}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding PercentageText}"
                       FontSize="30"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrandGradientBrush}" />
          </Grid>

          <ProgressBar Classes="brand"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding Percentage}"
                       IsIndeterminate="{Binding IsIndeterminate}" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="metric" Text="{Binding TransferSummary}" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding IsComplete}">
              <Border Width="7"
                      Height="7"
                      CornerRadius="4"
                      VerticalAlignment="Center"
                      Background="{StaticResource SuccessBrush}" />
              <TextBlock Text="Complete"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource SuccessBrush}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- Footer -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,24,0,0">
      <TextBlock Classes="footnote" Text="WINDOWS-FIRST · PORTABLE ARCHITECTURE" LetterSpacing="1.2" />
      <TextBlock Grid.Column="1"
                 Classes="footnote"
                 Text="Single transfer · queue and resume arrive in the next phases" />
    </Grid>

  </Grid>
</Window>
