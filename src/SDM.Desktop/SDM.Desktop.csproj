<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      The icon Windows itself uses: Explorer, the taskbar, Alt-Tab and the shortcut. It is
      separate from Window.Icon, which only dresses the window Avalonia draws, and without
      it the executable carries the generic .NET icon wherever SDM is not running.
    -->
    <ApplicationIcon>Assets\Branding\sdm.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SDM.Core\SDM.Core.csproj" />
    <ProjectReference Include="..\SDM.Application\SDM.Application.csproj" />
    <ProjectReference Include="..\SDM.Infrastructure\SDM.Infrastructure.csproj" />
    <ProjectReference Include="..\SDM.Database\SDM.Database.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    The browser launches the native host from wherever SDM was installed, and the host
    starts the application from beside itself. The two have to ship in one folder, so the
    host is built with the application and copied here rather than left in its own output
    directory where nothing would ever find it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SDM.NativeHost\SDM.NativeHost.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Where the host's own build put its output. Asked of the project rather than assembled
    from $(Configuration) and $(TargetFramework) by hand: the hand-built path is a guess
    that happens to be right for a default build and silently wrong for anything that
    moves an output directory.
  -->
  <Target Name="ResolveNativeHostOutput">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SDM.NativeHost\SDM.NativeHost.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="NativeHostAssembly" />
    </MSBuild>

    <ItemGroup>
      <NativeHostOutput Include="%(NativeHostAssembly.RootDir)%(NativeHostAssembly.Directory)SDM.NativeHost.*" />
    </ItemGroup>
  </Target>

  <Target Name="CopyNativeHost" AfterTargets="Build" DependsOnTargets="ResolveNativeHostOutput">
    <Copy SourceFiles="@(NativeHostOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    And again for publish, which is the only build anyone installs.

    The target above runs after Build, and publish does run Build — but it copies into
    $(OutDir), and publish then assembles its own folder from the items it knows about.
    The host is not one of them, because it is referenced with ReferenceOutputAssembly
    set to false. So every published SDM shipped without the executable Chrome launches:
    the extension was registered against a path with nothing at it, and the only symptom
    was the browser reporting "host not found".
  -->
  <Target Name="PublishNativeHost" AfterTargets="Publish" DependsOnTargets="ResolveNativeHostOutput">
    <Copy SourceFiles="@(NativeHostOutput)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
